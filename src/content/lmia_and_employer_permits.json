    "faq_items": [
      {
        "question": "What's the difference between an open and employer-specific work permit?",
        "answer": "An open work permit lets you work for any employer; an employer-specific permit restricts you to one employer and position."
      },
      {
        "question": "Do all job offers require an LMIA?",
        "answer": "No. Some are LMIA-exempt under the International Mobility Program (IMP). We'll assess this for you."
      },
      {
        "question": "How long is an LMIA valid for?",
        "answer": "Usually 6 months. You must apply for the work permit before it expires."
      },
      {
        "question": "Can I bring my family with me on a closed work permit?",
        "answer": "Yes, in most cases your spouse may apply for an open work permit and your children may study in Canada."
      },
      {
        "question": "Can I change employers later?",
        "answer": "Not with an employer-specific permit. You'd need a new job offer and, in most cases, a new work permit."
      }
    ],
